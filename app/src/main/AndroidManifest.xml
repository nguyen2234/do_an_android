<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android_app">

        <!-- Splash Screen -->
        <activity
            android:name=".ChaoMungActivity"
            android:exported="true"
            android:theme="@style/Theme.Android_app.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Authentication -->
        <activity
            android:name=".DangNhapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
            
        <activity
            android:name=".DangKyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- GiaoDich Result -->
        <activity
            android:name=".KetQuaGiaoDichActivity"
            android:exported="false"
            android:theme="@style/Theme.Android_app"/>

        <!-- Profile Edit -->
        <activity
            android:name=".ChinhSuaHoSoActivity"
            android:exported="false"
            android:theme="@style/Theme.Android_app"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Money Transfer -->
        <activity
            android:name=".ChuyenTienActivity"
            android:exported="false"
            android:theme="@style/Theme.Android_app"
            android:windowSoftInputMode="adjustResize"/>

    </application>

</manifest>