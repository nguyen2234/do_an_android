<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackTransfer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chuyển tiền"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Custom Modern Sliding Tab Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_bold"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabInternal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ví nội bộ"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBank"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ngân hàng"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- ================= INTERNAL TRANSFER CONTAINER ================= -->
            <LinearLayout
                android:id="@+id/containerInternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Sender Wallet -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Từ ví (Nguồn tiền)"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/spinnerSenderWallet"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:layout_marginBottom="20dp"
                            android:paddingHorizontal="16dp"/>

                        <!-- Receiver Wallet -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đến ví (Thụ hưởng)"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/spinnerReceiverWallet"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:layout_marginBottom="20dp"
                            android:paddingHorizontal="16dp"/>

                        <!-- Amount -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số tiền chuyển (VND)"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etInternalAmount"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="0 ₫"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- Note -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lời nhắn / Ghi chú"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etInternalNote"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="Chuyển tiền nội bộ"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btnConfirmInternal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="Chuyển khoản nội bộ"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:background="@drawable/bg_button_rounded"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================= BANK TRANSFER CONTAINER ================= -->
            <LinearLayout
                android:id="@+id/containerBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Source Wallet -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguồn tiền (Ví của bạn)"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/spinnerBankSourceWallet"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:layout_marginBottom="20dp"
                            android:paddingHorizontal="16dp"/>

                        <!-- Beneficiary Bank -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngân hàng thụ hưởng"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <Spinner
                            android:id="@+id/spinnerBeneficiaryBank"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:layout_marginBottom="20dp"
                            android:paddingHorizontal="16dp"/>

                        <!-- Beneficiary Account Number -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số tài khoản thụ hưởng"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etBeneficiaryAccount"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="Nhập số tài khoản"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- Beneficiary Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tên người thụ hưởng"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etBeneficiaryName"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="Nhập tên người nhận"
                            android:inputType="textCapCharacters"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- Amount -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Số tiền chuyển (VND)"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etBankAmount"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="0 ₫"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"
                            android:layout_marginBottom="20dp"/>

                        <!-- Note -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lời nhắn / Ghi chú"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etBankNote"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_input_bold"
                            android:hint="Chuyen tien nhanh"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="16sp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Save Button -->
                <Button
                    android:id="@+id/btnConfirmBank"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="Chuyển khoản ngân hàng"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:background="@drawable/bg_button_rounded"
                    android:textStyle="bold" />

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</LinearLayout>
