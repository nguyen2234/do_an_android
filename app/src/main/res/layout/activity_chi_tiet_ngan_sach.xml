<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình Chi tiết Ngân sách (ChiTietNganSachActivity)
    Cấu trúc: Header cố định trên cùng (AppBar + tổng quan) + RecyclerView danh sách giao dịch
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <!-- ===== HEADER / APP BAR ===== -->
    <RelativeLayout
        android:id="@+id/headerBudgetDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <!-- Nút quay lại -->
        <ImageView
            android:id="@+id/btnBackBudgetDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white"
            android:contentDescription="Quay lại"/>

        <!-- Tiêu đề màn hình -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chi tiết ngân sách"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- Nút Sửa (Edit) - góc phải -->
        <ImageView
            android:id="@+id/btnEditBudget"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/white"
            android:contentDescription="Sửa ngân sách"/>

        <!-- Nút Xóa (Delete) - góc phải ngoài cùng -->
        <ImageView
            android:id="@+id/btnDeleteBudget"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/white"
            android:contentDescription="Xóa ngân sách"/>
    </RelativeLayout>

    <!-- ===== THÂN TRANG (Scrollable) ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBudgetDetail"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===== CARD TỔNG QUAN NGÂN SÁCH ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Tên ngân sách -->
                    <TextView
                        android:id="@+id/tvDetailBudgetName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngân sách ăn uống tháng 6"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <!-- Khoảng thời gian áp dụng -->
                    <TextView
                        android:id="@+id/tvDetailBudgetDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="01/06/2026 → 30/06/2026"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"/>

                    <!-- Danh mục áp dụng -->
                    <TextView
                        android:id="@+id/tvDetailBudgetCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Áp dụng: Ăn uống, Mua sắm"
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimary"/>

                    <!-- Đường phân cách -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#F0F0F0"/>

                    <!-- Hàng số tiền: Đã chi / Hạn mức -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Bên trái: Đã chi -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đã chi"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary"/>

                            <TextView
                                android:id="@+id/tvDetailSpent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 ₫"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorExpense"/>
                        </LinearLayout>

                        <!-- Bên phải: Còn lại và hạn mức -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hạn mức"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary"/>

                            <TextView
                                android:id="@+id/tvDetailBudgetAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5.000.000 ₫"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"/>
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Phần trăm sử dụng -->
                    <TextView
                        android:id="@+id/tvDetailPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0% đã sử dụng"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary"/>

                    <!-- Thanh tiến độ -->
                    <ProgressBar
                        android:id="@+id/pbDetailBudget"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:progressDrawable="@drawable/progress_budget"
                        android:max="100"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== TIÊU ĐỀ DANH SÁCH GIAO DỊCH ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giao dịch thuộc ngân sách"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_centerVertical="true"/>

                <!-- Số lượng giao dịch -->
                <TextView
                    android:id="@+id/tvTransactionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="0 giao dịch"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"/>
            </RelativeLayout>

            <!-- ===== TRẠNG THÁI RỖNG (hiển thị khi chưa có giao dịch) ===== -->
            <LinearLayout
                android:id="@+id/layoutEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_piggy_bank"
                    android:alpha="0.3"
                    android:contentDescription="Chưa có giao dịch"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chưa có giao dịch nào\nthuộc ngân sách này"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextSecondary"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- ===== DANH SÁCH GIAO DỊCH (RecyclerView) ===== -->
            <!--
                Lưu ý: RecyclerView đặt bên trong NestedScrollView.
                Cần đặt nestedScrollingEnabled=false để tránh lỗi cuộn.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBudgetTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
