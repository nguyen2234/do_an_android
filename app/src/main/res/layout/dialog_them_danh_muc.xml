<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_white">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm Danh mục"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etCategoryName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên danh mục (vd: Mua sắm)"
        android:padding="12dp"
        android:background="@drawable/bg_input"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loại danh mục:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgCategoryType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        
        <RadioButton
            android:id="@+id/rbExpense"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Chi tiêu"
            android:checked="true"/>
            
        <RadioButton
            android:id="@+id/rbIncome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Thu nhập"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Màu sắc (Color):"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Color selection options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <View android:id="@+id/color1" android:layout_width="40dp" android:layout_height="40dp" android:background="#8B5CF6" android:layout_margin="4dp"/>
        <View android:id="@+id/color2" android:layout_width="40dp" android:layout_height="40dp" android:background="#E74C3C" android:layout_margin="4dp"/>
        <View android:id="@+id/color3" android:layout_width="40dp" android:layout_height="40dp" android:background="#2ECC71" android:layout_margin="4dp"/>
        <View android:id="@+id/color4" android:layout_width="40dp" android:layout_height="40dp" android:background="#F1C40F" android:layout_margin="4dp"/>
        <View android:id="@+id/color5" android:layout_width="40dp" android:layout_height="40dp" android:background="#3498DB" android:layout_margin="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hủy"
            android:backgroundTint="@color/colorTextSecondary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSaveCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lưu"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
