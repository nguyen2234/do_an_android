<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thay đổi mã PIN"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vui lòng thiết lập mã PIN giao dịch 6 chữ số mới."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    
    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input"
        android:hint="Nhập mã PIN mới (6 chữ số)"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:paddingHorizontal="16dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    
    <EditText
        android:id="@+id/etConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input"
        android:hint="Xác nhận mã PIN mới"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:paddingHorizontal="16dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"
        android:textSize="15sp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCancelChangePin"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorBackground"
            android:text="Hủy"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnConfirmChangePin"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:text="Lưu"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
