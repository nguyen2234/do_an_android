<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    
    <LinearLayout
        android:id="@+id/headerSetupWallet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            
            <View
                android:layout_width="36dp"
                android:layout_height="6dp"
                android:background="#80FFFFFF"
                android:layout_marginEnd="4dp"/>
            
            <View
                android:layout_width="36dp"
                android:layout_height="6dp"
                android:background="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Bước 2 / 2"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo ví tiền"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tạo ít nhất 1 ví để bắt đầu quản lý chi tiêu"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishSetupWallet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="✓ Hoàn thành"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:enabled="false"
        android:alpha="0.5"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="14dp"
        app:elevation="4dp"/>

    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSetupWallet"
        android:layout_above="@id/btnFinishSetupWallet"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thêm ví mới"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="12dp"/>

                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:startIconDrawable="@drawable/ic_wallet_modern"
                        app:startIconTint="@color/colorPrimary"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWalletNameSetup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Tên ví (VD: Tiền mặt, Vietcombank...)"
                            android:inputType="text"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:startIconDrawable="@drawable/ic_topup_modern"
                        app:startIconTint="@color/colorIncome"
                        app:suffixText="₫"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWalletBalanceSetup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Số dư ban đầu (để trống = 0)"
                            android:inputType="numberDecimal"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddWalletSetup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="+ Thêm ví này"
                        android:textSize="14sp"
                        app:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="10dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ví đã tạo"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:id="@+id/tvWalletCountSetup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ví"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"/>
            </LinearLayout>

            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWalletsSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
